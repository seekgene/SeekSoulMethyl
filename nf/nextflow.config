manifest {
    name            = 'nextflow-rna-methy-omics-data-analysis'
    author          = 'seekgene'
    description     = 'Nextflow SeekOne DD Single Cell Multiome Methylation + RNA analysis pipeline'
    version         = '2.2.0'
    nextflowVersion = '>=21.04.0'
}
params {
    workflow             = 'rna_met'
    samplesheet          = null
    outdir               = './results'
    workdir              = './work'
    database_dir         = ''
    genomeDir            = "${params.database_dir}/star"
    genomefa             = "${params.database_dir}/fasta/genome.fa"
    gtf                  = "${params.database_dir}/genes/genes.gtf"
    bismark_ref          = "${params.database_dir}/fasta/"
    chrom_size_path_full = "${params.database_dir}/bed/chr_len.bed"
    chrom_size_path      = "${params.database_dir}/bed/chr_nochrM.bed"
    methy_barcode_wl     = "${projectDir}/bin/barcodes/U3CB_methylation.txt"
    chemistry            = 'DD-MET5'
    exp_chemistry        = "${params.chemistry == 'DD-MET3' ? 'DDV2' : 'DD-MET5'}"
    cbcsv                = "${params.chemistry == 'DD-MET3' ? projectDir + '/bin/barcodes/DD-M_bUCB3_whitelist.csv' : projectDir + '/bin/barcodes/ME5_bUCB3_whitelist.csv'}"
    split_fastq          = 4
    filter_ch            = 2
    force_cell_number    = null
    pre_analysis_path    = null
    pre_outdir           = "${params.pre_analysis_path}/nextflowYaml/results"
    sample               = null
    oss_endpoint         = 'oss-cn-beijing-internal.aliyuncs.com'
    help                 = false
}

workDir = (params.workdir ?: './work').toString().replaceAll('\\s+', '_')
plugins {
    id 'nf-k8s@1.2.2'
}

resume = true
cleanup = false
trace {
    enabled = true
    file    = 'execution_trace.txt'
    overwrite = true
}

report {
    enabled = true
    file    = 'execution_report.html'
    overwrite = true
}

timeline {
    enabled = true
    file    = 'execution_timeline.html'
    overwrite = true
}

dag {
    enabled = true
    file    = 'pipeline_dag.html'
    overwrite = true
}

profiles {
    // Kubernetes
    aliyun_k8s {
        process.container = 'seekgene-registry-vpc.cn-beijing.cr.aliyuncs.com/seekgene/seeksoulmethyl:1.1.2'
        process.executor = 'k8s'
        k8s {
            namespace = 'nextflow'
            serviceAccount = 'default'
            storageClaimName = 'nextflow-proj2-pvc'
            storageMountPath = '/PROJ2/'
            imagePullPolicy = 'IfNotPresent'
            debug {
                yaml = true
            }
            pod = [
                [imagePullSecrets: 'regcred' ],
                [ttlSecondsAfterFinished: 604800],
                [env: 'AccessKeyId', secret:'lv-oss/AccessKeyId'],
                [env: 'AccessKeySecret', secret:'lv-oss/AccessKeySecret'],
                [label: 'alibabacloud.com/acs', value: 'true'],
                [label: 'alibabacloud.com/compute-class', value: 'general-purpose'],
                [annotation: 'alibabacloud.com/custom-tags', value: 'ARGO_NODE_ID:' + (System.getenv('ARGO_NODE_ID') ?: 'unknown') ],
                [annotation: 'alibabacloud.com/cpu-vendors', value: 'intel,amd' ]

            ]
        }
    }
    aliyun_k8s_argo {
        process.container = 'seekgene-registry-vpc.cn-beijing.cr.aliyuncs.com/seekgene/seeksoulmethyl:1.1.2'
        process.executor = 'k8s'
        k8s {
            namespace = 'argo'
            serviceAccount = 'default'
            storageClaimName = 'standard3-pvc'
            storageMountPath = '/proj'
            imagePullPolicy = 'IfNotPresent'
            debug {
                yaml = true
            }
            pod = [
                [imagePullSecrets: 'regcred' ],
                [ttlSecondsAfterFinished: 604800],
                [env: 'AccessKeyId', secret:'lv-oss/AccessKeyId'],
                [env: 'AccessKeySecret', secret:'lv-oss/AccessKeySecret'],
                [volumeClaim: "data-pvc", mountPath: "/data" ],
                [volumeClaim: "reference-pvc", mountPath: "/reference" ],
                [label: 'alibabacloud.com/acs', value: 'true'],
                [label: 'alibabacloud.com/compute-class', value: 'general-purpose'],
                [annotation: 'alibabacloud.com/custom-tags', value: 'ARGO_NODE_ID:' + (System.getenv('ARGO_NODE_ID') ?: 'unknown') ],
                [annotation: 'alibabacloud.com/cpu-vendors', value: 'intel,amd' ]
            ]
        }
    }
    docker {
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions = '-u $(id -u):$(id -g) '
        process.container = 'ghcr.io/seekgene/seeksoulmethyl_docker:v1.0.0'
    }
    local_test {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '4 GB'
        process.maxForks = 2
        docker.enabled = false
    }
}

// Memory-on-retry policy used by all dynamic-memory processes below.
// Double the requested memory ONLY when the previous attempt died from an OOM-class signal:
//   134 = SIGABRT (abort, often from out-of-memory abort handlers)
//   137 = SIGKILL (Linux OOM-killer / k8s OOMKilled)
//   138 = SIGBUS
//   139 = SIGSEGV
//   140 = SIGUSR1 (some schedulers emit this on memory-limit hit)
// Any other exit code (notably 143 = SIGTERM from k8s node preemption / pod eviction) retries at
// the SAME memory level, so transient infrastructure churn does not inflate requests and slow
// down rescheduling on capacity-constrained clusters.
// Notes:
//   - Requires Nextflow >= 24.10.0 for task.previousTrace.
//   - The TraceRecord field name is 'exit' (not 'exitStatus'); using 'exitStatus' here would raise
//     "Not a valid TraceRecord field" on the first retry. Verified by local trace test 2026-06-25.
def oomAwareMemory = { base, task ->
    task.attempt == 1
        ? base
        : ((task.previousTrace.exit == 134 || task.previousTrace.exit in 137..140)
            ? task.previousTrace.memory * 2
            : task.previousTrace.memory)
}

process {
    cpus      = 2
    memory    = '4.GB'
    errorStrategy = 'retry'
    maxRetries = 3
    maxSubmitAwait = 30.m
    pod = {
        task.attempt <= 1 ? [
            [label: 'alibabacloud.com/compute-qos', value: 'best-effort']] 
            : 
            [[label: 'alibabacloud.com/compute-qos', value: 'default']]
    }
    withName: 'COMPUTE_CPG_SITES' {
        cpus = 2
        memory = '10 GB'
    }

    withName: 'GTF_TO_GENE_BED' {
        cpus = 2
        memory = '10 GB'
    }

    withName: 'FASTP_EXPRESSION_MULTI' {
        cpus = 16
        memory = { oomAwareMemory(30.GB, task) }
    }

    withName: 'FASTP_METHYLATION_MULTI' {
        cpus = 16
        memory = { oomAwareMemory(30.GB, task) }
    }

    withName: 'SEEKSOULTOOLS_RNA' {
        cpus = 16
        memory = { oomAwareMemory(64.GB, task) }
    }

    withName: 'METHYLATION_BARCODE_EXTRACTION' {
        cpus = 16
        memory = { oomAwareMemory(48.GB, task) }
    }

    withName: 'FASTP_METHYLATION_BARCODE_EXTRACT' {
        cpus = 6
        memory = '20 GB'
    }

    withName: 'FASTP_METHYLATION_BARCODE_EXTRACT_F' {
        cpus = 6
        memory = '20 GB'
    }

    withName: 'FASTP_METHYLATION_BARCODE_EXTRACT_R' {
        cpus = 6
        memory = '20 GB'
    }

    withName: 'SORT_BAM_BY_NAME' {
        cpus = 10
        memory = '12 GB'
    }

    withName: 'SORT_BAM_BY_NAME_F' {
        cpus = 10
        memory = '12 GB'
    }

    withName: 'SORT_BAM_BY_NAME_R' {
        cpus = 10
        memory = '12 GB'
    }

    withName: 'SPLIT_BAM_FILES' {
        cpus = 4
        memory = '20 GB'
    }
    
    withName: 'SPLIT_BAM_FILES_F' {
        cpus = 4
        memory = '20 GB'
    }

    withName: 'SPLIT_BAM_FILES_R' {
        cpus = 4
        memory = '20 GB'
    }

    withName: 'MERGE_BISMARK_BAM' {
        cpus = 4
        memory = '16 GB'
    }

    withName: 'PARSE_FASTQ_FILES' {
        cpus = 2
        memory = '4 GB'
    }
    
    withName: 'CREATE_FORWARD_PAIRS' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'CREATE_REVERSE_PAIRS' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'BISMARK_ALIGNMENT_FORWARD' {
        cpus = 32
        memory = { oomAwareMemory(80.GB, task) }
    }

    withName: 'BISMARK_ALIGNMENT_REVERSE' {
        cpus = 32
        memory = { oomAwareMemory(80.GB, task) }
    }

    withName: 'MERGE_FILTERED_BARCODE_READS_COUNTS' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'ALLCOOLS_BAM_TO_ALLC' {
        cpus = 32
        memory = '64 GB'
    }

    withName: 'ALLCOOLS_GENERATE_DATASETS' {
        cpus = 32
        memory = { oomAwareMemory(32.GB, task) }
    }

    withName: 'MERGE_MCDS' {
        cpus = 2
        memory = { oomAwareMemory(4.GB, task) }
    }

    withName: 'ALLCOOLS_SUBMERGE' {
        cpus = 24
        memory = '48 GB'
    }

    withName: 'ALLCOOLS_MERGE' {
        cpus = 24
        memory = { oomAwareMemory(48.GB, task) }
    }

    withName: 'ALLCOOLS_EXTRACT' {
        cpus = 2
        memory = { oomAwareMemory(10.GB, task) }
    }

    withName: 'METHYLATION_SUMMARY' {
        cpus = 2
        memory = { oomAwareMemory(10.GB, task) }
    }

    withName: 'METHYLATION_LSI_PCA_CLUSTERING' {
        cpus = 8
        memory = { oomAwareMemory(32.GB, task) }
        maxForks = 1
    }

    withName: 'COUNTS_MAPPED_READS' {
        cpus = 4
        memory = '16 GB'
    }
    withName: 'COUNTS_MAPPED_READS_F' {
        cpus = 4
        memory = '16 GB'
    }
    withName: 'COUNTS_MAPPED_READS_R' {
        cpus = 4
        memory = '16 GB'
    }

    withName: 'ESTIMATED_CELLS' {
        cpus = 4
        memory = '16 GB'
    }

    withName: 'MULTI_REPORT' {
        cpus = 8
        memory = { oomAwareMemory(32.GB, task) }
    }

    withName: 'RUN_RNA_FORCE' {
        cpus = 16
        memory = { oomAwareMemory(64.GB, task) }
    }

    withName: 'FORCE_CELL_MERGE_AND_SUBSET_MCDS' {
        cpus = 4
        memory = { oomAwareMemory(32.GB, task) }
    }
    withName: 'ALLCOOLS_GENERATE_DATASETS_PART' {
        cpus = 16
        memory = { oomAwareMemory(16.GB, task) }
    }

    withName: 'RESOLVE_PRE_ANALYSIS_ROOT' {
        cpus = 2
        memory = '8 GB'
    }

    withName: 'PRECHECK_SAMPLE' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'STAGE_METHY_ASSETS' {
        cpus = 2
        memory = '8 GB'
    }

    withName: 'STAGE_BISMARK_ASSETS' {
        cpus = 2
        memory = '8 GB'
    }

    withName: 'FORCE_CELL_BARCODE_DIFF' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'FORCE_CELL_APPLY_ALLOCOOLS_CHANGES' {
        cpus = 4
        memory = '16 GB'
    }

    withName: 'FORCE_CELL_DISCOVER_BUCKET_DIRS' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'FORCE_CELL_ADAPT_BUCKET_FOR_SUBMERGE' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'FORCE_CELL_RECOMPUTE_CELLS_METRICS' {
        cpus = 4
        memory = '16 GB'
    }

    withName: 'FORCE_CELL_UPDATE_FILTERED_READS_COUNTS' {
        cpus = 2
        memory = '4 GB'
    }

}
