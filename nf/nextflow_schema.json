{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nextflow-rna-methy-omics-data-analysis//nextflow_schema.json",
  "title": "nextflow-rna-methy-omics-data-analysis pipeline parameters",
  "description": "Nextflow SeekGene RNA-MET data analysis pipeline",
  "type": "object",
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "required": ["outdir"],
      "properties": {
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
          "fa_icon": "fas fa-folder-open"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/input_output_options"
    }
  ],
  "properties": {
    "samplesheet": {
      "type": "string"
    },
    "seeksoultools_path": {
      "type": "string"
    },
    "database_dir": {
      "type": "string"
    },
    "genomeDir": {
      "type": "string"
    },
    "genomefa": {
      "type": "string"
    },
    "gtf": {
      "type": "string"
    },
    "bismark_ref": {
      "type": "string"
    },
    "chrom_size_path": {
      "type": "string"
    },
    "cbcsv": {
      "type": "string"
    },
    "methy_barcode_wl": {
      "type": "string"
    },
    "chemistry": {
      "type": "string"
    },
    "exp_chemistry": {
      "type": "string"
    },
    "split_fastq": {
      "type": "integer",
      "default": 4,
      "minimum": 1
    },
    "filter_ch": {
      "type": "integer",
      "default": 2,
      "minimum": 0
    }
  },
  "required": [
    "database_dir",
    "samplesheet",
    "chemistry",
    "split_fastq",
    "filter_ch"
  ]
}
